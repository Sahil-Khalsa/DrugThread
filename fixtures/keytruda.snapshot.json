{
  "drug": {
    "id": "pembrolizumab",
    "name": "Keytruda",
    "genericName": "Pembrolizumab",
    "brandName": "Keytruda",
    "manufacturer": "Merck",
    "status": "Approved"
  },
  "summary": {
    "description": "Keytruda (Pembrolizumab) is a monoclonal antibody that targets the PD-1 receptor on T cells, enhancing the immune system's ability to fight cancer. It is approved for multiple cancer types, including melanoma and non-small cell lung cancer, but carries risks of immune-mediated adverse reactions and other serious side effects.",
    "mechanism": "Pembrolizumab is a monoclonal antibody that binds to the PD-1 receptor on T cells, blocking its interaction with PD-L1 and PD-L2.",
    "target": "PD-1"
  },
  "findings": [
    {
      "id": "finding-1",
      "title": "Multiple Trial Terminations Involving Pembrolizumab",
      "category": "development",
      "severity": "high",
      "summary": "Several clinical trials involving Pembrolizumab were terminated due to issues such as lack of tolerability, unexpected pulmonary toxicity, and lack of efficacy. Notably, a trial combining Pembrolizumab with Capmatinib was terminated due to tolerability issues, and another with Abemaciclib due to pulmonary toxicity.",
      "evidenceIds": [
        "ev-NCT04139317",
        "ev-NCT03938337",
        "ev-NCT05256381"
      ],
      "confidence": "primary",
      "reviewStatus": "unreviewed",
      "targetTab": "history"
    },
    {
      "id": "finding-2",
      "title": "Pembrolizumab's Shared Mechanism with CTLA-4 Inhibitors",
      "category": "network",
      "severity": "medium",
      "summary": "Pembrolizumab shares a similar immune checkpoint inhibition mechanism with CTLA-4 inhibitors like YERVOY and IMJUDO, which also aim to enhance the immune response against tumors.",
      "evidenceIds": [
        "ev-fda-YERVOY",
        "ev-fda-IMJUDO"
      ],
      "confidence": "secondary",
      "reviewStatus": "unreviewed",
      "targetTab": "network"
    },
    {
      "id": "finding-3",
      "title": "Warnings on Immune-Mediated Adverse Reactions",
      "category": "label",
      "severity": "high",
      "summary": "Keytruda's label includes warnings about serious immune-mediated adverse reactions, which align with the trial terminations due to safety concerns, such as pulmonary toxicity observed in combination therapies.",
      "evidenceIds": [
        "ev-fda-label",
        "ev-NCT03938337"
      ],
      "confidence": "primary",
      "reviewStatus": "unreviewed",
      "targetTab": "label"
    }
  ],
